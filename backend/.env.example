# ── Bat buoc doi truoc khi dung that ─────────────────────────────
# Khoa ky JWT. Sinh bang: openssl rand -hex 32
SECRET_KEY=

# Khoa noi bo cho cac agent (eBPF agent, sensor agent tren Proxmox host)
# gui du lieu vao backend. Sinh bang: openssl rand -hex 24
INTERNAL_API_KEY=aegis-dev-key

# ── Ket noi Proxmox VE ───────────────────────────────────────────
# PROXMOX_TOKEN_ID chi la ten token (vi du 'aegis'), khong phai 'root@pam!aegis'
PROXMOX_HOST=
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=aegis
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=False

MOCK_PROXMOX=False
OTX_API_KEY=
THREATFOX_API_KEY=
ABUSEIPDB_API_KEY=
MAXMIND_LICENSE_KEY=

# AI Configuration (Local or Cloud)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
GEMINI_API_KEY=

# ── Trang Infrastructure (giam sat ha tang Proxmox) ──────────────
# Bang thong uplink gia dinh cua moi node, dung de tinh % vong tron "Bang thong"
NET_LINK_MBPS=1000
# Nguong canh bao vang / do cho dia, CPU, RAM, bang thong, storage pool
INFRA_WARN_PERCENT=80
INFRA_CRIT_PERCENT=90
# Chu ky poll Proxmox va broadcast WebSocket (giay)
INFRA_POLL_SECONDS=5
